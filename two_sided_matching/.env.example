# Copy to .env to override. Compose reads .env automatically.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=lab
POSTGRES_PORT=5435

# The lab's Python reads LAB_DSN. Point it anywhere with pgvector installed if
# you would rather not use the compose database.
# LAB_DSN=postgresql://lab:lab@localhost:5435/lab

# Which embedder ./lab.sh embed uses by default.
#   bm25-hashed   offline, no downloads (default)
#   hashed-tfidf  offline, simpler, slightly worse on long postings
#   minilm        needs sentence-transformers + a ~90MB model download
#   openai        needs OPENAI_API_KEY
# LAB_EMBEDDER=bm25-hashed
