# Copy to .env to override. Compose reads .env automatically.
REDIS_PORT=6381
POSTGRES_PORT=5437
GATEWAY_PORT=8090
DASHBOARD_PORT=8091
NGINX_PORT=8092
API_DIRECT_PORT=8093
API_SIGNED_PORT=8096
AUTHZ_PORT=8094
INSIGHT_PORT=8097

# How the API service decides who is asking: client | gateway | signed.
# Scenario 03 is a tour of all three.
LAB_SUBJECT_TRUST=gateway

# Shared secrets. Two of them, deliberately: the JWT secret authenticates the
# CLIENT to the gateway; the gateway secret authenticates the GATEWAY to the
# upstream. One secret doing both jobs means anyone who can mint a client token
# can also forge a gateway assertion.
LAB_JWT_SECRET=dev-jwt-secret
LAB_GATEWAY_SECRET=dev-gateway-secret

# How long a positive RBAC verdict is cached. This IS the revocation latency
# for anything the denylist does not cover — scenario 04.
LAB_DECISION_TTL=30
